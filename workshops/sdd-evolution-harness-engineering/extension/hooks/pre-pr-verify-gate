# installed by sdd-evolution-harness-engineering workshop
#!/usr/bin/env bash
# pre-pr-verify-gate — enforces canonical project/issues/<N>/ paths before PR.
# Intended to be invoked manually (workshop verify) or as a pre-push hook.
set -e
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
violations=()

# Walk staged or HEAD-tracked files under project/issues/
while IFS= read -r path; do
  [ -z "$path" ] && continue
  rel="${path#${ROOT}/}"
  case "$rel" in
    project/issues/*)
      n="$(echo "$rel" | awk -F/ '{print $3}')"
      [ -z "$n" ] && continue
      # canonical structure must be research/plan/implementation
      bucket="$(echo "$rel" | awk -F/ '{print $4}')"
      case "$bucket" in
        research|plan|implementation|verify.md|"") : ;;
        *) violations+=("non-canonical bucket: ${rel}") ;;
      esac
      ;;
  esac
done < <(find "$ROOT/project/issues" -type f 2>/dev/null | head -n 200)

if [ "${#violations[@]}" -gt 0 ]; then
  echo "pre-pr-verify-gate: FAIL" >&2
  echo "Failed invariant: project/issues/<N>/ must follow canonical {research,plan,implementation} layout." >&2
  for v in "${violations[@]}"; do echo "  - ${v}" >&2; done
  echo "Remediation: move offending files to the canonical bucket before opening a PR." >&2
  exit 1
fi
exit 0
