#!/usr/bin/env bash
# installed by sdd-evolution-harness-engineering workshop
# Canonical offline entrypoint for the SDD-evolution-harness workshop.
# Pure POSIX-flavoured bash; runs without Node.js or the Copilot SDK.
# All SDK-only features print a degraded-mode banner and exit gracefully.
#
# Pinned Node.js minimum (informational; bash entrypoint does not require Node):
#   Node.js >= v20 (tested on v24.15.0)
# Pinned SDK reference (informational; only used by extension/commands/*.ts):
#   @github/copilot-sdk@1.0.0-beta.4

set -u

# ---------- locate workshop root and lib ----------
WORKSHOP_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSHOP_ROOT="$(cd "${WORKSHOP_BIN}/../.." && pwd)"
WORKSHOP_LIB="${WORKSHOP_ROOT}/extension/lib"
WORKSHOP_HOOKS="${WORKSHOP_ROOT}/extension/hooks"
WORKSHOP_COMMANDS_DIR="${WORKSHOP_ROOT}/extension/commands"
WORKSHOP_MODULES="${WORKSHOP_ROOT}/modules"
WORKSHOP_SLUG="sdd-evolution-harness-engineering"
WORKSHOP_MARKER="# installed by ${WORKSHOP_SLUG} workshop"

export WORKSHOP_BIN WORKSHOP_ROOT WORKSHOP_LIB WORKSHOP_HOOKS \
       WORKSHOP_COMMANDS_DIR WORKSHOP_MODULES WORKSHOP_SLUG WORKSHOP_MARKER

# ---------- source libs ----------
# shellcheck disable=SC1090,SC1091
. "${WORKSHOP_LIB}/state.sh"
# shellcheck disable=SC1091
. "${WORKSHOP_LIB}/lock.sh"
# shellcheck disable=SC1091
. "${WORKSHOP_LIB}/drift.sh"
# shellcheck disable=SC1091
. "${WORKSHOP_LIB}/hooks.sh"
# shellcheck disable=SC1091
. "${WORKSHOP_LIB}/scaffold.sh"
# shellcheck disable=SC1091
. "${WORKSHOP_LIB}/onboard.sh"
# shellcheck disable=SC1091
. "${WORKSHOP_LIB}/diagnose.sh"
# shellcheck disable=SC1091
. "${WORKSHOP_LIB}/coach.sh"

# ---------- NO_COLOR / TERM=dumb compliance ----------
if [ "${NO_COLOR:-}" = "1" ] || [ "${TERM:-}" = "dumb" ]; then
  WORKSHOP_COLOR=0
else
  WORKSHOP_COLOR=1
fi
export WORKSHOP_COLOR

# ---------- flock hard-fail ----------
require_flock() {
  if [ "${WORKSHOP_TEST_NO_FLOCK:-0}" = "1" ] || ! command -v flock >/dev/null 2>&1; then
    echo "ERROR: required capability 'flock' is missing from PATH." >&2
    echo "Install util-linux (provides flock) and retry. Aborting." >&2
    exit 127
  fi
}

# ---------- SDK availability + degraded-mode banner ----------
sdk_available() {
  if [ "${WORKSHOP_FORCE_OFFLINE:-0}" = "1" ]; then return 1; fi
  command -v copilot >/dev/null 2>&1 || return 1
  command -v node >/dev/null 2>&1 || return 1
  return 0
}

print_degraded_banner() {
  echo "[${WORKSHOP_SLUG}] inferential coaches disabled — running in degraded mode" >&2
  echo "[${WORKSHOP_SLUG}] SDK (@github/copilot-sdk) or copilot CLI unavailable; bash fallback active" >&2
}

# ---------- argv parsing helpers ----------
HAS_JSON=0
HAS_HELP=0
HAS_YES=0
HAS_DRY_RUN=0
HAS_UPGRADE=0
ARGS=()
EXTRA=()
parse_global_flags() {
  ARGS=()
  for arg in "$@"; do
    case "$arg" in
      --json) HAS_JSON=1 ;;
      --help|-h) HAS_HELP=1 ;;
      --yes|-y) HAS_YES=1 ;;
      --dry-run) HAS_DRY_RUN=1 ;;
      --upgrade) HAS_UPGRADE=1 ;;
      *) ARGS+=("$arg") ;;
    esac
  done
}

# ---------- canonical command inventory ----------
ALL_COMMANDS=(
  start install-hooks next status verify coach diagnose reset run debrief
  scaffold override reconcile onboard install-promote-ephemeral fan-out
  accept-draft reject-draft help
)

cmd_help() {
  if [ "$HAS_JSON" = "1" ]; then
    printf '{"workshop":"%s","version":"1.0.0","commands":[' "$WORKSHOP_SLUG"
    local sep=""
    for c in "${ALL_COMMANDS[@]}"; do
      printf '%s"%s"' "$sep" "$c"
      sep=","
    done
    printf '],"layout":"extension+modules","offline":true}\n'
    return 0
  fi
  cat <<EOF
${WORKSHOP_SLUG} — SDD-evolution harness workshop

Usage: workshop <command> [args...] [--json] [--yes] [--help]

Commands:
  start                       Initialise workshop state (state file + .gitignore entry)
  install-hooks               Install (chain) computational sensors as git hooks
  next [--to <module>]        Advance to next module if invariants pass
  status                      Show state, drift, ledger, and pending drafts (supports --json)
  verify [--dry-run]          Run current module's invariants (supports --json)
  coach <topic>               Invoke an inferential coach (degrades to banner when SDK absent)
  diagnose 2x2                Classify guides+sensors into the 2×2 lens (supports --json)
  reset                       Restore backups, remove workshop hooks, delete state file (idempotent)
  run <module>                Open a module's action sheet
  debrief                     Print the current module's debrief questions
  scaffold <kind> [args]      Emit a draft candidate (research|plan|verify|adr|core-component|guide|sensor)
  override --reason "<text>"  One-commit invariant bypass with ledger entry
  reconcile                   Re-baseline state after a confirmed drift
  onboard <path> [--yes]      Inspect a brownfield repo and emit ADR/CC draft candidates
  install-promote-ephemeral   Promote an ephemeral artifact to project/issues/<N>/ (stretch)
  fan-out --count <n>         Spawn N worktrees and run RPIV concurrently (stretch)
  accept-draft <id>           Apply a previously scaffolded draft to canonical paths
  reject-draft <id>           Discard a previously scaffolded draft
  help [--json]               Show this help

Flags: --json (status/verify/diagnose/help), --yes, --dry-run, --upgrade, --help
Env:   NO_COLOR=1, TERM=dumb, WORKSHOP_FORCE_OFFLINE=1
EOF
}

# ---------- subcommands ----------
cmd_start() {
  require_flock
  sdk_available || print_degraded_banner
  if [ "${HAS_UPGRADE:-0}" = "0" ]; then
    # side-by-side install refusal: presence of a prior install marker
    if [ -f "$(repo_root)/.workshop-install-marker" ] && [ ! -f "$(state_file)" ]; then
      echo "ERROR: previously-installed workshop detected (.workshop-install-marker). Use --upgrade to replace." >&2
      return 1
    fi
  fi
  with_lock _start_locked
}
_start_locked() {
  local root; root="$(repo_root)"
  state_init
  ensure_gitignore_entry ".workshop-state.json"
  : > "${root}/.workshop-install-marker"
  echo "workshop: started — state at ${root}/.workshop-state.json"
}

cmd_status() {
  local drift; drift="$(detect_drift || true)"
  if [ "$HAS_JSON" = "1" ]; then
    state_emit_json "$drift"
    return 0
  fi
  echo "workshop status"
  echo "  state file:     $(state_file)"
  if [ -f "$(state_file)" ]; then
    echo "  current module: $(state_get currentModule)"
    echo "  branch:         $(state_get branch)"
    echo "  invariants:     $(state_get invariantsMet)"
    echo "  installed hooks:$(state_get_installed_hooks_summary)"
    echo "  override ledger:$(state_get_override_ledger_summary)"
    echo "  pending drafts: $(state_get_pending_drafts_summary)"
  else
    echo "  (no state file — run 'workshop start')"
  fi
  if [ -n "$drift" ]; then
    echo "  *** drift detected: ${drift} — recommend 'workshop reconcile' ***"
  fi
}

cmd_verify() {
  local drift; drift="$(detect_drift || true)"
  local pass=1
  local module; module="$(state_get currentModule 2>/dev/null || echo module-0)"
  local fails=()
  # Module invariants: minimal but real — must be on a branch, must have a state file,
  # for non-baseline modules must have committed at least one module artifact.
  if [ ! -f "$(state_file)" ]; then
    fails+=("no state file — run 'workshop start'")
    pass=0
  fi
  if [ -n "$drift" ]; then
    fails+=("drift detected: ${drift}")
    pass=0
  fi
  if [ "$HAS_JSON" = "1" ]; then
    printf '{"module":"%s","invariantsMet":%s,"drift":"%s","failures":[' \
      "$module" "$([ $pass -eq 1 ] && echo true || echo false)" "${drift:-}"
    local sep=""
    for f in "${fails[@]:-}"; do
      [ -z "$f" ] && continue
      printf '%s"%s"' "$sep" "$(printf '%s' "$f" | sed 's/"/\\"/g')"
      sep=","
    done
    printf ']}\n'
  else
    if [ $pass -eq 1 ]; then
      echo "verify: PASS (module=${module})"
    else
      echo "verify: FAIL (module=${module})" >&2
      for f in "${fails[@]}"; do echo "  - ${f}" >&2; done
      echo "remediation: address each failure then re-run 'workshop verify'." >&2
    fi
  fi
  [ $pass -eq 1 ] || return 1
}

cmd_next() {
  local target=""
  for ((i=0; i<${#ARGS[@]}; i++)); do
    if [ "${ARGS[$i]}" = "--to" ] && [ $((i+1)) -lt ${#ARGS[@]} ]; then
      target="${ARGS[$((i+1))]}"
    fi
  done
  if [ -n "$target" ]; then
    require_flock
    with_lock state_set currentModule "$target"
    echo "workshop: advanced to ${target}"
    return 0
  fi
  if ! cmd_verify >/dev/null 2>&1; then
    echo "workshop next: refused — current module invariants fail." >&2
    cmd_verify >&2 || true
    return 1
  fi
  require_flock
  with_lock state_advance_module
  echo "workshop: advanced to $(state_get currentModule)"
}

cmd_reset() {
  require_flock
  with_lock _reset_locked
}
_reset_locked() {
  local removed=()
  hooks_restore_all removed
  local sf; sf="$(state_file)"
  if [ -f "$sf" ]; then rm -f "$sf"; removed+=("$sf"); fi
  local marker; marker="$(repo_root)/.workshop-install-marker"
  [ -f "$marker" ] && rm -f "$marker" && removed+=("$marker")
  if [ ${#removed[@]} -eq 0 ]; then
    echo "workshop reset: no-op (nothing to remove)"
  else
    echo "workshop reset: removed:"
    for r in "${removed[@]}"; do echo "  - $r"; done
  fi
}

cmd_install_hooks() {
  require_flock
  with_lock hooks_install
}

cmd_override() {
  local reason=""
  for ((i=0; i<${#ARGS[@]}; i++)); do
    if [ "${ARGS[$i]}" = "--reason" ] && [ $((i+1)) -lt ${#ARGS[@]} ]; then
      reason="${ARGS[$((i+1))]}"
    fi
  done
  if [ -z "$reason" ]; then
    echo "ERROR: workshop override requires --reason \"<text>\"" >&2
    return 1
  fi
  require_flock
  with_lock state_record_override "$reason"
  echo "workshop override: recorded — one-commit bypass active. Next commit is re-gated."
}

cmd_reconcile() {
  require_flock
  with_lock _reconcile_locked
}
_reconcile_locked() {
  state_set headSha "$(git -C "$(repo_root)" rev-parse HEAD 2>/dev/null || echo unknown)"
  state_set branch "$(git -C "$(repo_root)" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
  echo "workshop reconcile: state re-baselined to current HEAD"
}

cmd_run() {
  local mod="${ARGS[0]:-}"
  if [ -z "$mod" ]; then echo "ERROR: usage: workshop run <module-id>" >&2; return 1; fi
  local file
  file="$(ls "${WORKSHOP_MODULES}/"*"${mod}"*.md 2>/dev/null | head -n1)"
  if [ -z "$file" ] || [ ! -f "$file" ]; then
    file="${WORKSHOP_MODULES}/${mod}.md"
  fi
  if [ ! -f "$file" ]; then
    echo "ERROR: module not found: ${mod}" >&2; return 1
  fi
  cat "$file"
}

cmd_debrief() {
  local mod; mod="$(state_get currentModule 2>/dev/null || echo module-0)"
  local file
  file="$(ls "${WORKSHOP_MODULES}/"*"${mod#module-}"*.md 2>/dev/null | head -n1)"
  if [ -z "$file" ] || [ ! -f "$file" ]; then file="${WORKSHOP_MODULES}/00-baseline.md"; fi
  awk '/^## Debrief/,/^## /{ if($0 !~ /^## [^D]/) print }' "$file"
}

cmd_coach() {
  local topic="${ARGS[0]:-}"
  if [ -z "$topic" ]; then echo "ERROR: usage: workshop coach <topic>" >&2; return 1; fi
  if ! sdk_available; then print_degraded_banner; fi
  coach_dispatch "$topic" "${ARGS[@]:1}"
}

cmd_diagnose() {
  local what="${ARGS[0]:-2x2}"
  if [ "$what" != "2x2" ]; then echo "ERROR: only 'diagnose 2x2' implemented" >&2; return 1; fi
  diagnose_2x2 "$HAS_JSON"
}

cmd_scaffold() {
  local kind="${ARGS[0]:-}"
  if [ -z "$kind" ]; then echo "ERROR: usage: workshop scaffold <kind> [title]" >&2; return 1; fi
  require_flock
  with_lock scaffold_emit_draft "$kind" "${ARGS[@]:1}"
}

cmd_accept_draft() {
  local id="${ARGS[0]:-}"
  if [ -z "$id" ]; then echo "ERROR: usage: workshop accept-draft <id>" >&2; return 1; fi
  require_flock
  with_lock scaffold_accept "$id"
}

cmd_reject_draft() {
  local id="${ARGS[0]:-}"
  if [ -z "$id" ]; then echo "ERROR: usage: workshop reject-draft <id>" >&2; return 1; fi
  require_flock
  with_lock scaffold_reject "$id"
}

cmd_onboard() {
  local target="${ARGS[0]:-}"
  if [ -z "$target" ]; then echo "ERROR: usage: workshop onboard <path> [--yes]" >&2; return 1; fi
  require_flock
  with_lock onboard_run "$target" "$HAS_YES"
}

cmd_install_promote_ephemeral() {
  local id="${ARGS[0]:-}"
  if [ -z "$id" ]; then echo "ERROR: usage: workshop install-promote-ephemeral <issue-number>" >&2; return 1; fi
  require_flock
  with_lock scaffold_promote_ephemeral "$id"
}

cmd_fan_out() {
  local count=2
  for ((i=0; i<${#ARGS[@]}; i++)); do
    if [ "${ARGS[$i]}" = "--count" ] && [ $((i+1)) -lt ${#ARGS[@]} ]; then
      count="${ARGS[$((i+1))]}"
    fi
  done
  require_flock
  fan_out_run "$count"
}

# ---------- dispatcher ----------
main() {
  if [ $# -eq 0 ]; then cmd_help; return 0; fi
  local sub="$1"; shift || true
  parse_global_flags "$@"
  if [ "$HAS_HELP" = "1" ] && [ "$sub" != "help" ]; then
    echo "workshop ${sub}: see 'workshop help' for the full inventory."
    return 0
  fi
  case "$sub" in
    help)                       cmd_help ;;
    start)                      cmd_start ;;
    install-hooks)              cmd_install_hooks ;;
    next)                       cmd_next ;;
    status)                     cmd_status ;;
    verify)                     cmd_verify ;;
    coach)                      cmd_coach ;;
    diagnose)                   cmd_diagnose ;;
    reset)                      cmd_reset ;;
    run)                        cmd_run ;;
    debrief)                    cmd_debrief ;;
    scaffold)                   cmd_scaffold ;;
    override)                   cmd_override ;;
    reconcile)                  cmd_reconcile ;;
    onboard)                    cmd_onboard ;;
    install-promote-ephemeral)  cmd_install_promote_ephemeral ;;
    fan-out)                    cmd_fan_out ;;
    accept-draft)               cmd_accept_draft ;;
    reject-draft)               cmd_reject_draft ;;
    --version|-V)               echo "${WORKSHOP_SLUG} 1.0.0" ;;
    *)
      echo "ERROR: unknown command '${sub}'. Run 'workshop help'." >&2
      return 2
      ;;
  esac
}

main "$@"
